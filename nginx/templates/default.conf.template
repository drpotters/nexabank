# NexaBank nginx server config.
# This file is rendered by the nginxinc entrypoint via `envsubst` at container
# startup. Only the ${VARS} listed in NGINX_ENVSUBST_FILTER (set in the
# Dockerfile) are substituted; nginx's own $variables are left untouched.

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # ---- Workload introspection endpoints ----------------------------------
    # These help verify Kubernetes deployments: which pod/node served the
    # request, where the client came from, and the container's identity.

    # /health: liveness/readiness health check for the pod. Returns 200 + JSON
    # when nginx is serving. Excluded from access logs to reduce probe noise.
    location = /health {
        access_log off;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"status":"ok","pod_name":"${POD_NAME}","node_name":"${NODE_NAME}","app":"${APP_NAME}","version":"${APP_VERSION}","server_time":"$time_iso8601"}\n';
    }

    # /ready: origin-pool health check endpoint for the F5 XC load balancer.
    #
    # Why it's separate from /health:
    #   /health is used by the Kubernetes liveness and readiness probes and must
    #   always return 200 while nginx is serving. If it failed:
    #     - liveness: kubelet restarts the container, which also wipes
    #       /tmp/unhealthy, so the simulated fault clears itself mid-test.
    #     - readiness: the pod drops out of the Service EndpointSlice, and F5 XC
    #       service discovery removes the origin. That tests discovery, not the
    #       XC health check.
    #   /ready should be probed only by the F5 XC origin-pool health check
    #   A failure here leaves the pod Running, Ready and discovered, and only the
    #   XC health check marks it down, as it would for a real application failure.
    #
    # Fault injection (resiliency test T4):
    #   touch /tmp/unhealthy  -> 503; XC marks the origin unhealthy and stops
    #                            sending it traffic.
    #   rm /tmp/unhealthy     -> 200; XC marks it healthy again after the
    #                            healthy threshold is met.
    #   /tmp is writable by the unprivileged nginx user (uid 101), so
    #   `kubectl exec` can toggle it with no extra permissions.
    #
    # Note: "if" inside a location is safe here because its only action is
    # "return" (see nginx's "If is Evil" guidance).
    location = /ready {
        access_log off;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        if (-f /tmp/unhealthy) {
            return 503 '{"status":"unready","pod_name":"${POD_NAME}"}\n';
        }
        return 200 '{"status":"ready","pod_name":"${POD_NAME}"}\n';
    }

    # /pod-info: details about the pod/node serving this request.
    location = /pod-info {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Host-Provider "${HOST_PROVIDER}" always;
        return 200 '{"pod_name":"${POD_NAME}","pod_namespace":"${POD_NAMESPACE}","pod_ip":"${POD_IP}","node_name":"${NODE_NAME}","hostname":"${HOSTNAME}","app":"${APP_NAME}","version":"${APP_VERSION}","host_provider":"${HOST_PROVIDER}","server_time":"$time_iso8601"}\n';
    }

    # /origin-info: details about where the request came from, plus which
    # pod/node/platform served it. Pod values come from the Downward API and
    # HOST_PROVIDER identifies the underlying platform (aws|gcp|vmware|azure).
    location = /origin-info {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Host-Provider "${HOST_PROVIDER}" always;
        return 200 '{"client_ip":"$remote_addr","x_forwarded_for":"$http_x_forwarded_for","x_forwarded_proto":"$http_x_forwarded_proto","x_real_ip":"$http_x_real_ip","host":"$host","scheme":"$scheme","request_method":"$request_method","uri":"$request_uri","user_agent":"$http_user_agent","pod_name":"${POD_NAME}","pod_namespace":"${POD_NAMESPACE}","pod_ip":"${POD_IP}","node_name":"${NODE_NAME}","host_provider":"${HOST_PROVIDER}","server_time":"$time_iso8601"}\n';
    }

    # /whoami: identity of the container/workload answering the request.
    location = /whoami {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Host-Provider "${HOST_PROVIDER}" always;
        return 200 '{"hostname":"${HOSTNAME}","pod_name":"${POD_NAME}","pod_namespace":"${POD_NAMESPACE}","node_name":"${NODE_NAME}","app":"${APP_NAME}","version":"${APP_VERSION}","served_by":"nginx","host_provider":"${HOST_PROVIDER}","server_time":"$time_iso8601"}\n';
    }

    # ---- Static site --------------------------------------------------------
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff2?|ttf|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }
    location / {
        try_files $uri $uri/ =404;
    }

}
